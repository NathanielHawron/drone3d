#version 330 core

layout(location = 0) in vec4 position;
layout(location = 1) in vec2 texCoord;
layout(location = 2) in vec3 normal;

out vec2 v_TexCoord;
out vec3 v_position;
out vec3 v_normal;

uniform mat4 U_vpMat;
uniform mat4 U_mMat;

void main() {
	vec4 vpos = U_mMat * position;
	gl_Position = U_vpMat * vpos;
    v_position = vpos.xyz;
	v_TexCoord = texCoord;
	v_normal = (U_mMat * vec4(normal,0)).xyz;
};